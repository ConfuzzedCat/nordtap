@page "/"
@using System.Diagnostics.CodeAnalysis
@using System.Security.Claims
@using System.Text.Json
@using frontend.Components.Elements.ElementData
@using frontend.Services
@using frontend.Utils
@using frontend.Components.Elements.Grid
@using frontend.Components.Elements.Grid.Events

@inject ILogger<Home> Logger
@inject IInternalApiService InternalApiService

@rendermode InteractiveServer


<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.
<button @onclick="AddChild">addChild</button> 
<button @onclick="AddCol">addRow</button> 

<GridContainer @ref="_child">
</GridContainer>

@if (string.IsNullOrWhiteSpace(_username) is false)
{
    /*
    
    OnDragStart="OnDragStart"
    OnDrop="OnDrop"
    OnDragEnd="OnDragEnd"
    Columns="gridCol" Rows="3">
    
     */
    <p>Hello @_username</p>
}

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    GridContainer _child = null!;
    private GridPosition SelectedPosition { get; set; }
    private int gridCol = 3;

    private string _username = string.Empty;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var doesAuthCookieExist = HttpContext.Request.Cookies.ContainsKey("NordtapCookie");
            if (doesAuthCookieExist)
            {
                var cookies = CookieUtils.JoinCookies(HttpContext.Request.Cookies);
                var response = await InternalApiService.GetUsername(cookies);
                if (string.IsNullOrWhiteSpace(response) is false)
                {
                    _username = response;
                }
            }
        }
        catch (Exception e)
        {
            Logger.LogWarning("Failed to get username, {exception}", e);
        }
    }
    
    private void OnDragStart(GridDragEventArgs eventArgs)
    {
        SelectedPosition = eventArgs.Position;
    }


    private async Task OnDrop(GridDragEventArgs eventArgs)
    {
        GridItem? gridItemOld, gridItemNew = null;
        bool doesSecondItemExist = false;
        try
        {
            gridItemOld = await _child.Remove(SelectedPosition);
        }
        catch (Exception e)
        {
            Logger.LogError(e, "Couldn't find first grid item selected.");
            return;
        }
        try
        {
            gridItemNew = await _child.Remove(eventArgs.Position);
            doesSecondItemExist = true;
        }
        catch (Exception)
        {
            doesSecondItemExist = false;
        }

        bool didFirstRegister, didSecondRegister = false;
        didFirstRegister = await _child.Register(eventArgs.Position, gridItemOld);
        if (doesSecondItemExist)
        {
            didSecondRegister = await _child.Register(SelectedPosition, gridItemNew);
        }
        Logger.LogInformation("Did first register: {first}. Did second register: {second}", didFirstRegister, didSecondRegister);
        
        //await _child.MoveItem(SelectedPosition, eventArgs.Position);
        StateHasChanged();
    }

    private void OnDragEnd(GridDragEventArgs eventArgs)
    {
        SelectedPosition = GridPosition.Empty;
    }

    public async Task AddChild()
    {
        await _child.AddChild();
    }

    private void AddCol()
    {
        gridCol++;
    }

}
