@page "/"
@using frontend.Components.Elements
@using frontend.Services
@using frontend.Components.Elements.Grid
@using frontend.Web

@inject ILogger<Home> Logger
@inject IInternalApiService InternalApiService

@inject CustomAuthenticationStateProvider AuthStateProvider

<PageTitle>Home</PageTitle>
<h1>Hello, world!</h1>

Welcome to your new app.
<button @onclick="AddChild">addChild</button> 

<GridContainer @ref="_child" AllowDragging="@false">
</GridContainer>

@if (string.IsNullOrWhiteSpace(_username) is false)
{
    <p>Hello @_username</p>
}

@code {
    //[CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    GridContainer _child = null!;
    private string _username = string.Empty;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (await AuthStateProvider.IsAuthenticatedAsync())
            {
                var currentUser = await AuthStateProvider.GetCurrentUserAsync();
                var response = currentUser is null ? "UsernameNotFound" : currentUser.Username;
                if (string.IsNullOrWhiteSpace(response) is false)
                {
                    _username = response;
                }
            }
        }
        catch (Exception e)
        {
            Logger.LogWarning("Failed to get username, {exception}", e);
        }
    }
    
    public async Task AddChild()
    {
        await _child.AddChild();
    }
}
