@using frontend.Components.Elements.ElementData
@using frontend.Components.Elements.Grid.Events
@using frontend.Web
@inject ILogger<GridItem> Logger
@inject IJSRuntime Js
@implements IContext


@if (showContextMenu)
{
    <div style="position: absolute; @_cssStylingContext;"
         class="context-menu-container" @onclick:stopPropagation>
        @if (IsOwnedByUser)
        {
            <section class="context-menu-item context-menu-item-hoverable" @onclick="LockContextHandler">
                @if (IsItemLocked)
                {
                    <text>Unlock Item</text>
                }
                else
                {
                    <text>Lock Item</text>
                }
            </section>
            <section class="context-menu-item context-menu-item-hoverable" @onclick="DeleteContextHandler">
                Delete Item
            </section>
            <section class="context-menu-item context-menu-item-hoverable" @onclick="StickyContextHandler">
                Stick Item to another Item
            </section>
        }
        <section class="context-menu-item">
            Is owned by you: @IsOwnedByUser
        </section>
    </div>
}

<div style="position: absolute; @_cssStyling; bottom: auto; right: auto; z-index: @ZIndex"
     @onmouseover="async (args) => { /* Add internal callback here */ ; await ConvertEvent(args, OnMouseOverCallback); }"
     @ondragstart="async (args) => { await OnDragStart(args); await ConvertEvent(args, OnDragStartCallback); }"
     @ondragend="async (args) => { await OnDragEnd(args); await ConvertEvent(args, OnDragEndCallback); }"
     @ondrop="async (args) => { ; await ConvertEvent(args, OnDropCallback); }"
     @oncontextmenu="async (args) => { await OnContextMenu(args); }"
     @onclick="OnClick"
     @ondragover:preventDefault="true"
     @oncontextmenu:preventDefault="true"


     draggable="@IsDraggable().ToString()"
     @ref="ItemContainerReference">
    @ChildContent
    @if (StickyChild is not null)
    {
        <GridItem
            GridPosition="@(new GridPosition(GridPosition.X, GridPosition.Y-20))"
            ChildContent="@StickyChild.ChildContent"
            IsOwnedByUser="@IsOwnedByUser"
            GridKernelSizeX="@GridKernelSizeX"
            GridKernelSizeY="@GridKernelSizeY"
            IsStickyChild="@true"
            ZIndex="@(ZIndex-1)"
            OnRemove="@OnRemoveSticky">
        </GridItem>
    }
</div>



@code {
    [CascadingParameter] public Dictionary<GridPosition, GridItem> ParentItems { get; set; }
    [CascadingParameter] public BoundingClientRect ParentBoundingClientRect { get; set; }
    [CascadingParameter(Name = "NotifyParentOfContext")] public Action<IContext> ParentContextAction { get; set; }
    [CascadingParameter(Name = "CurrentStickySelector")] public GridItem? CurrentStickySelector { get; set; }
    [CascadingParameter(Name = "IsStickyMode")] public bool IsStickyMode { get; set; }

    
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public GridItem? CloneItem { get; set; }
    [Parameter] public GridPosition GridPosition { get; set; }
    [Parameter] public EventCallback<GridPosition> OnRemove { get; set; }
    [Parameter] public EventCallback<bool> OnStickyModeChange { get; set; }
    [Parameter] public EventCallback<GridItem?> OnCurrentStickySelectorChange { get; set; }
    
    [Parameter] public EventCallback<MouseEventArgs>     OnMouseMoveCallback     { get; set; }
    [Parameter] public EventCallback<GridMouseEventArgs> OnMouseOverCallback     { get; set; }
    [Parameter] public EventCallback<GridDragEventArgs>  OnDragStartCallback     { get; set; }
    [Parameter] public EventCallback<GridDragEventArgs>  OnDragEndCallback       { get; set; }
    [Parameter] public EventCallback<GridDragEventArgs>  OnDragEnterCallback     { get; set; }
    [Parameter] public EventCallback<GridDragEventArgs>  OnDragLeaveCallback     { get; set; }
    [Parameter] public EventCallback<GridDragEventArgs>  OnDragOverCallback      { get; set; }
    [Parameter] public EventCallback<GridDragEventArgs>  OnDropCallback          { get; set; }
    [Parameter] public bool                              IsSelecting             { get; set; }
    [Parameter] public bool                              IsSelected              { get; set; }
    [Parameter] public bool                              IsTarget                { get; set; }
    [Parameter] public bool                              IsOwnedByUser           { get; set; }
    [Parameter] public bool                              IsStickyChild           { get; set; }
    [Parameter] public double                            GridKernelSizeX         { get; set; }
    [Parameter] public double                            GridKernelSizeY         { get; set; }
    [Parameter] public int                               ZIndex                  { get; set; }
    [Parameter] public GridItem?                         StickyChild             { get; set; }
    
    private ElementReference ItemContainerReference { get; set; }
    public bool showContextMenu { get; set; }
    public bool IsItemLocked { get; set; }
    
    private BoundingClientRect _boundingClientRect;
    private (double X, double Y) _startDragPosition;
    private string _cssStyling = String.Empty;
    private string _cssStylingContext = String.Empty;
    private double _startX, _startY, _previewX, _previewY;
    private bool _isHovering;
    private bool _isStickySelector = false;

    public static GridItem CloneStatic(GridItem other)
    {
        var newItem = new GridItem();
        newItem.Clone(other);
        return newItem;
    }

    protected override Task OnInitializedAsync()
    {
        if (ParentItems is null)
        {
            throw new Exception("Parent needs to be GridContainer");
        }

        GridPosition = new GridPosition(
            CalculateGridKernelPosition(GridPosition.X, GridKernelSizeX),
            CalculateGridKernelPosition(GridPosition.Y, GridKernelSizeY));

        _startX = GridPosition.X;
        _startY = GridPosition.Y;
        _cssStyling = CreateCssStyling(GridPosition.X, GridPosition.Y);
        if (CloneItem is not null)
        {
            Clone(CloneItem);
        }

        if (GridKernelSizeX == 0)
        {
            GridKernelSizeX = 5;
        }
        if (GridKernelSizeY == 0)
        {
            GridKernelSizeY = 5;
        }

        IsItemLocked = !IsOwnedByUser;
        
        return base.OnInitializedAsync();
    }

    private void Clone(GridItem cloneItem)
    {
        ChildContent = cloneItem.ChildContent;
        GridPosition = cloneItem.GridPosition;
        _startX = cloneItem._startX;
        _startY = cloneItem._startY;
        StickyChild = cloneItem.StickyChild;
    }

    private async Task ConvertEvent(DragEventArgs args, EventCallback<GridDragEventArgs> eventCallback)
    {
        Logger.LogInformation("ConvertEvent Called.");
        
        var newArgs = new GridDragEventArgs(GridPosition, args);
        await eventCallback.InvokeAsync(newArgs);
        StateHasChanged();
    }
    
    private async Task ConvertEvent(MouseEventArgs args, EventCallback<GridMouseEventArgs> eventCallback)
    {
        Logger.LogInformation("ConvertEvent Called.");
        var newArgs = new GridMouseEventArgs(GridPosition, args);
        await eventCallback.InvokeAsync(newArgs);
        StateHasChanged();
    }

    async Task OnDragStart(DragEventArgs args)
    {
        if (IsDraggable() == false)
        {
            return;
        }
        
        _boundingClientRect = await Js.InvokeAsync<BoundingClientRect>(
            "DOMGetBoundingClientRect", 
            [ItemContainerReference]);
        _startDragPosition = (args.ClientX, args.ClientY);

    }
    
    async Task OnDragEnd(DragEventArgs args)
    {
        if (IsDraggable() == false)
        {
            return;
        }
        Logger.LogInformation("Child Bounding box: {box}", _boundingClientRect);
        Logger.LogInformation("Parent Bounding box: {box}", ParentBoundingClientRect);
        var newPosX = args.ClientX + (_boundingClientRect.X - _startDragPosition.X);
        var newPosY = args.ClientY + (_boundingClientRect.Y - _startDragPosition.Y);
        var x = 
            Math.Clamp(
                Math.Round(newPosX),
                ParentBoundingClientRect.X,
                Math.Round(
                    ParentBoundingClientRect.X + 
                    ParentBoundingClientRect.Width - 
                    _boundingClientRect.Width));
        var y = 
            Math.Clamp(
                Math.Round(newPosY),
                ParentBoundingClientRect.Y,
                Math.Round(
                    ParentBoundingClientRect.Y + 
                    ParentBoundingClientRect.Height - 
                    _boundingClientRect.Height));
        
        x = CalculateGridKernelPosition(x, GridKernelSizeX);
        y = CalculateGridKernelPosition(y, GridKernelSizeY);
        var newGridPos = new GridPosition(x, y);
        if (ParentItems.ContainsKey(newGridPos))
        {
            return;
        }
        Logger.LogInformation("gridPos: {gridPos}", newGridPos);
        ParentItems.Remove(GridPosition);
        GridPosition = newGridPos;
        ParentItems.Add(GridPosition, this);
        _cssStyling = CreateCssStyling(GridPosition.X, GridPosition.Y);
        StateHasChanged();
    }

    private double CalculateGridKernelPosition(double number, double gridKernel)
    {
        return Math.Round((number / gridKernel)) * gridKernel;
    }

    private string CreateCssStyling(double x, double y)
    {
        return $"top: {y}px; left: {x}px;";
    }

    private async Task OnContextMenu(MouseEventArgs args)
    {
        if (args.Button == 2)
        {
            _cssStylingContext = CreateCssStyling(args.ClientX, args.ClientY);
            ParentContextAction.Invoke(this);
            StateHasChanged();
        }
    }

    public void NotifyChange()
    {
        StateHasChanged();
    }

    private async Task DeleteContextHandler()
    {
        await OnRemove.InvokeAsync(GridPosition);
    }

    private void LockContextHandler()
    {
        IsItemLocked = !IsItemLocked;
        showContextMenu = false;
        StateHasChanged();
    }

    private bool IsDraggable()
    {
        return (IsOwnedByUser && IsItemLocked == false && IsStickyMode == false && IsStickyChild == false);
    }

    private void OnRemoveSticky()
    {
        StickyChild = null;
        StateHasChanged();
    }

    private async Task StickyContextHandler()
    {
        IsStickyMode = true;
        showContextMenu = false;
        _isStickySelector = true;
        await OnStickyModeChange.InvokeAsync(true);
        await OnCurrentStickySelectorChange.InvokeAsync(this);
        StateHasChanged();
    }

    private async Task OnClick(MouseEventArgs obj)
    {
        if (obj.Button != 0)
        {
            return;
        }
        if (IsStickyMode == false)
        {
            return;
        }

        if (_isStickySelector)
        {
            return;
        }

        if (CurrentStickySelector == null)
        {
            return;
        }

        await CurrentStickySelector.AttachToGridItem(CloneStatic(CurrentStickySelector));
        CurrentStickySelector = null;
    }

    public async Task AttachToGridItem(GridItem item)
    {
        await OnStickyModeChange.InvokeAsync(false);
        //_cssStyling = CreateCssStyling(0, 20);
        item.StickyChild = this;
        item.NotifyChange();
        StateHasChanged();
        //await OnRemove.InvokeAsync(item.GridPosition);
    }
}