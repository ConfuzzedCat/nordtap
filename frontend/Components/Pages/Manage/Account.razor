@page "/Manage/Account"
@using System.Text.Json
@using frontend.Services
@using frontend.Utils

@inject ILogger<Account> Logger
@inject HttpClient HttpClient
@inject IInternalApiService InternalApiService

<h3>Account</h3>

@if (_info.Length > 0)
{
    <p>Info from server:</p>
    <p>@_info</p>
}
    
@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    private string _info = "";

    protected override async Task OnInitializedAsync()
    {
        var doesAuthCookieExist = HttpContext.Request.Cookies.ContainsKey("NordtapCookie");
        if (doesAuthCookieExist)
        {
            var cookies = CookieUtils.JoinCookies(HttpContext.Request.Cookies);
            var response = await InternalApiService.GetUserInfo(cookies);
            if (response is not null)
            {
                _info = JsonSerializer.Serialize(response);
            }
        }
    }

}
