@using frontend.Components.Elements.ElementData
@using frontend.Components.Elements.Grid.Events
@using frontend.Web
@using _Imports = frontend._Imports
@inject ILogger<GridContainer> Logger
@inject IJSRuntime Js

<pre>children:@Items.Count</pre>
<div class="grid-container" @ref="ItemReference">
    <CascadingValue Value="BoundingClientRect" IsFixed="true">
        <CascadingValue Value="@Items">
            @foreach (var item in Items)
            {
                <GridItem
                    CloneItem="item.Value"
                    GridPosition="item.Key"
                    Draggable="@AllowDragging"
                    GridKernelSizeX="10"
                    GridKernelSizeY="10"
                    OnRemove="OnRemoveCallback" >
                </GridItem>
            }
        </CascadingValue>
    </CascadingValue>
</div>
@code {
    
    // Make it more of an absolute position system, instead of row and columns
    [Parameter] public int Columns { get; set; }
    [Parameter] public int Rows { get; set; }
    [Parameter] public bool AllowDragging { get; set; }
    [Parameter] public EventCallback<GridDragEventArgs> OnDragStart { get; set; }
    [Parameter] public EventCallback<GridDragEventArgs> OnDragEnd { get; set; }
    [Parameter] public EventCallback<GridDragEventArgs> OnDragEnter { get; set; }
    [Parameter] public EventCallback<GridDragEventArgs> OnDragLeave { get; set; }
    [Parameter] public EventCallback<GridDragEventArgs> OnDrop { get; set; }
    [Parameter] public Dictionary<GridPosition, GridItem> Items { get; set; } = new();

    public BoundingClientRect BoundingClientRect { get; private set; }
    public ElementReference ItemReference { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            BoundingClientRect = await Js.InvokeAsync<BoundingClientRect>(
                "DOMGetBoundingClientRect", 
                [ItemReference]);
        }
    }

    public async Task<bool> Register(GridPosition pos, GridItem item)
    {
        try
        {
            Items.Add(pos, item);
        }
        catch (ArgumentException)
        {
            Logger.LogWarning("Can't add element at pos: {pos}", pos);
            return false;
        }
        StateHasChanged();
        return true;
    }

    public async Task AddChild()
    {
        var rand = new Random();
        double x = Math.Round(rand.NextDouble() * 1900d);
        double y = Math.Round(rand.NextDouble() * 900d);
        var pos = new GridPosition(x, y);
        
        var didRegister =  await Register(pos, new GridItem
        {
            GridPosition = pos,
            ChildContent = @<img class="card-img" src="https://cards.scryfall.io/large/front/4/f/4f663979-a778-4fb2-97c4-67ab82926f13.jpg"/>
        });
        
        Logger.LogInformation("Did it register? {didRegister}", didRegister);
        StateHasChanged();
    }

    private void OnRemoveCallback(GridPosition pos)
    {
        Items.Remove(pos);
        StateHasChanged();
        Logger.LogInformation("Removing Item: {pos}", pos);
    }
}