@page "/Login"
@using System.ComponentModel.DataAnnotations
@using System.Net
@using System.Net.Http.Headers
@using System.Text.Json
@using backend.Extensions.Models
@using frontend.Extensions
@using frontend.Services
@using frontend.Utils
@using frontend.Web
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.AspNetCore.Identity
@using Cookie = frontend.Web.Cookie

@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager
@inject HttpClient HttpClient
@inject IInternalApiService InternalApiService
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@* @inject IdentityRedirectManager RedirectManager *@

@rendermode InteractiveServer

<h3>Login</h3>

<EditForm Model="Input" method="post" OnValidSubmit="LoginUser" FormName="login" class="">
    <StatusMessage Message="@errorMessage"/>
    <DataAnnotationsValidator/>
    <ValidationSummary class="" role="alert"/>
    <div class="">
        <label for="login-username">Username</label>
        <div class="">
            <InputText id="login-username" @bind-Value="Input.Username" class="" autocomplete="username" aria-required="true" placeholder="Username"/>
        </div>
        <ValidationMessage For="() => Input.Username" class=""/>
    </div>
    <div class="">
        <label for="login-password">Password</label>
        <div class="">
            <InputText id="login-password" type="password" @bind-Value="Input.Password" class="" autocomplete="current-password" aria-required="true" placeholder="password"/>
        </div>
        <ValidationMessage For="() => Input.Password" class=""/>
    </div>
    <div class="">
        <label for="login-twofactorcode">Two-factor code</label>
        <div class="">
            <InputText id="login-twofactorcode" @bind-Value="Input.TwoFactorCode" class="" autocomplete="one-time-code" aria-required="true" placeholder="123456 or XXX-XXX"/>
        </div>
        <ValidationMessage For="() => Input.TwoFactorCode" class=""/>
    </div>
    <div class="">
        <label class="">
            <InputCheckbox @bind-Value="Input.RememberMe"/>
            Remember me
        </label>
    </div>
    <div class="">
        <button type="submit" class="">Log in</button>
    </div>
    <div class="">
        <a href="Account/ForgotPassword">Forgot your password?</a>
        @* <NewLineLink Path="Account/ForgotPassword" NewTab="false" Text="Forgot your password?"/> *@
    </div>
    <hr/>
    <div class="">
        @* <NewLineLink
            Path="@(NavigationManager.GetUriWithQueryParameters("Account/Register", new Dictionary<string, object?> { ["ReturnUrl"] = ReturnUrl }))"
            NewTab="false"
            Text="Register as a new user"/> *@
        @* <NewLineLink Path="Account/ResendEmailConfirmation" NewTab="false" Text="Resend email confirmation"/> *@
    </div>
</EditForm>

@code {
    private string? errorMessage;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // ReSharper disable once AutoPropertyCanBeMadeGetOnly.Local
    [SupplyParameterFromForm] private InputModel Input { get; set; } = new();

    
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    
    private Cookie _cookie = Cookie.Empty;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_cookie.IsEmpty() == false)
        {
            Logger.LogInformation("Cookie wasn't empty, setting. key: {key}", _cookie.Key);
            await LocalStorage.SetItemAsStringAsync(_cookie.Key, _cookie.ToString());
            //await LocalStorage.SetItemAsync(_cookie.Key, _cookie);
            _cookie = Cookie.Empty;
        }
    }

    public async Task LoginUser()
    {
        // This doesn't count login failures towards account lockout
        // To enable password failures to trigger account lockout, set lockoutOnFailure: true
        var result = await InternalApiService.PostLogin(Input.ToRequest());
        
        switch (result.ResultStatus)
        {
            case LoginResult.Status.Succeeded:
                var cookie = result.Cookie;
                _cookie = cookie;
                Logger.LogInformation("User logged in.");
                if (ReturnUrl != null)
                {
                    NavigationManager.NavigateTo(ReturnUrl);
                }
                else
                {
                    NavigationManager.NavigateTo("/");
                }
                return;
            case LoginResult.Status.Failed:
                errorMessage = "Error: Invalid login attempt.";
                return;
            case LoginResult.Status.LockedOut:
                //TODO: Add page for lockout
                Logger.LogWarning("User account locked out.");
                NavigationManager.NavigateTo("Account/Lockout");
                return;
            case LoginResult.Status.NotAllowed:
                errorMessage = "Error: login not allowed.";
                return;
            case LoginResult.Status.RequiresTwoFactor:
                //TODO: Add page for 2fa
                //var uri = new Uri("Account/LoginWith2fa", UriKind.Relative);
                //uri.AddParameter("returnUrl", ReturnUrl);
                //uri.AddParameter("rememberMe", Input.RememberMe.ToString());
                //NavigationManager.NavigateTo(uri.ToString());
                return;
            default:
                throw new ArgumentOutOfRangeException();
        }
    }
    
    private sealed class InputModel
    {
        [Required] public string Username { get; set; } = "";

        [Required]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        public string? TwoFactorCode { get; set; }

        [Display(Name = "Remember me?")] public bool RememberMe { get; set; }

        internal LoginRequest ToRequest()
        {
            if (TwoFactorCode != null && TwoFactorCode.Contains('-'))
            {
                return new ()
                {
                    Username = this.Username,
                    Password = this.Password,
                    RememberMe = this.RememberMe,
                    TwoFactorRecoveryCode = this.TwoFactorCode
                };
            }
            
            return new ()
            {
                Username = this.Username,
                Password = this.Password,
                RememberMe = this.RememberMe,
                TwoFactorCode = this.TwoFactorCode
            };
        }
    }
}