@using frontend.Web
<CascadingValue Value="NotifyParentOfContext" IsFixed="true" Name="NotifyParentOfContext">
    <div @onclick="OnClick">
        @ChildContent
    </div>
</CascadingValue>
@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private static IContext? _currentContextShow;
    public readonly Action<IContext> NotifyParentOfContext = item =>
    {
        if (_currentContextShow != null)
        {
            _currentContextShow.showContextMenu = false;
            _currentContextShow.NotifyChange();
            _currentContextShow = null;
        }
        item.showContextMenu = true;
        _currentContextShow = item;
    };
    private void OnClick()
    {
        if (_currentContextShow == null)
        {
            return;
        }
        _currentContextShow.showContextMenu = false;
        _currentContextShow.NotifyChange();
        _currentContextShow = null;
        StateHasChanged();
    }
}
